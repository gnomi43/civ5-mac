#!/bin/bash
# Двойной щелчок в Finder. Лечит два известных случая «игра не запускается»:
#  - Steam пишет «OS Error 256» / macOS «can't be opened» — сломана подпись приложения;
#  - игра открывается и через ~20 с сама закрывается — испорчен кэш текстов.
# Безопасно запускать в любой момент (при закрытой игре).
ROOT="$(cd "$(dirname "$0")" && pwd)"; . "$ROOT/Civ5-ru-patch/common.sh"
title "починить запуск"
check_game
wait_game_closed
chmod +x "$XP"/crossplay.sh "$TR"/terrain.sh 2>/dev/null

step "Кэш текстов (игра пересоберёт его при запуске)"
run "кэш текстов очищен" "$TR/terrain.sh" fixcache

step "Подпись приложения"
run "приложение переподписано" "$XP/crossplay.sh" sign

step "Проверка версии"
if "$XP/crossplay.sh" status 2>&1 | grep -q "ПАТЧ ПРИМЕНЁН"; then
  ok "билд как у Windows"
else
  warn "Steam, похоже, обновил или восстановил игру — открой «1. Установить или обновить»"
fi

echo
echo "Теперь запусти игру из Steam. Первый запуск после этого будет чуть дольше."
echo "Если опять не запускается — пришли помощнику фото этого окна и окна «2. Проверить»."
finish
